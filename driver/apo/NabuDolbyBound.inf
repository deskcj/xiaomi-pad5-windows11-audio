[Version]
Signature="$WINDOWS NT$"
Class=Extension
ClassGuid={E2F84CE7-8EFA-411C-AA69-97454CA4CB57}
ExtensionId={FD13C2DF-5315-4F4F-9556-F78FB784A12A}
Provider=%Provider%
DriverVer=11/26/2026,1.0.2140.37
CatalogFile=NabuDolbyBound.cat
PnpLockdown=1
[Manufacturer]
%Provider%=Models,NTarm64.10.0...26100
[Models.NTarm64.10.0...26100]
%Description%=NabuBound,AUDD\VEN_QCOM&DEV_052C&SUBSYS_MTPA8150
[NabuBound.NTarm64]
[NabuBound.NTarm64.Components]
AddComponent=NabuDolbyGlobal,,NabuComponent
[NabuComponent]
ComponentIds=VEN_DSKC&CID_NABUDOLBYGLOBAL
Description="Nabu original Dolby audio-interface SFX lab"
[NabuBound.NTarm64.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologySpeaker%,BoundSpeakerInterface
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologySpeaker%,BoundSpeakerInterface
[BoundSpeakerInterface]
AddReg=BoundSpeakerSfx
[BoundSpeakerSfx]
HKR,FX\0,%PKEY_FX_Association%,,%KSNODETYPE_SPEAKER%
HKR,FX\0,%PKEY_FX_StreamEffectClsid%,,%APO_CLSID%
HKR,FX\0,%PKEY_SFX_ProcessingModes%,0x00010000,%MODE_DEFAULT%,%MODE_MEDIA%
; APOInitSystemEffects3 opens this exact context's Default store. Do not also
; publish the same custom bank property in the legacy flat FX\0 store.
HKR,FX\0\%APO_CLSID%,%PKEY_FX_Association%,,%KSNODETYPE_SPEAKER%
HKR,FX\0\%APO_CLSID%\Default,%PKEY_NabuDolbyBank%,,"Global\NabuDolbyBank-9df8834a-209e-4cc1-bc73-bb4353adfa9f"
; Provision the CAPX User store without writing or replacing any user preference.
HKR,FX\0\%APO_CLSID%\User,,0x00000010
